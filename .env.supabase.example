# =============================================================================
# MECHA — Supabase environment template (STAGED MIGRATION — placeholders only)
# Branch: supabase-migration-staging · Plan: files/TOOL_STACK_INTEGRATION_2026-11-14.md (P4)
# Runbook: docs/SUPABASE_MIGRATION_RUNBOOK.md
#
# NO REAL VALUES LIVE HERE. The Supabase project does not exist yet; when it is
# created (Mecha-app GitHub identity), the real values are handed over through
# the Secure Vault and set in the Vercel env — never committed to git.
# =============================================================================

# --- The one variable the app actually switches at cutover -------------------
# Every pg-Pool module (lib/server/store.ts, lib/server/appStore.ts,
# lib/server/betterAuth.ts) reads this single connection string from the env.
# At cutover it becomes the Supabase DIRECT connection string (port 5432 —
# NOT the transaction pooler on 6543; DDL/migrations and pg_restore need the
# direct connection).
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# --- Supabase project values -------------------------------------------------
# Used by the staged follow-ons (Storage for the health vault, pgvector
# search, and any future Supabase Auth evaluation). Not read by the app yet.
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>

# Server-only. Bypasses row-level security — NEVER expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# The database password chosen when the project is created. Vault only;
# it is also embedded in DATABASE_URL above.
SUPABASE_DB_PASSWORD=<DB_PASSWORD>

# --- Unchanged by this migration (listed so the cutover check misses nothing)
# BETTER_AUTH_SECRET / BETTER_AUTH_URL — Better Auth keeps running against the
#   Supabase Postgres connection via its existing pg Pool; no auth swap.
# JWT_SECRET, GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET, STRIPE_* , SMTP_*,
# ANTHROPIC_API_KEY / OPENROUTER_API_KEY, CLIENT_URL — all untouched.
